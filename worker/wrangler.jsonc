{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smc-stock-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [
    { "pattern": "standardmobileco.com/api/*", "zone_name": "standardmobileco.com" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "smc-stock", "database_id": "c2098a25-408a-4c73-be84-bb3213682b95", "migrations_dir": "migrations" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "OFFER_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true },
  "vars": {
    "SITE_ORIGIN": "https://standardmobileco.com",
    "TEAM_EMAIL": "smcom1000@gmail.com",
    "FROM_EMAIL": "offers@standardmobileco.com",
    "ZELLE_RECIPIENT": "alex@standardmobilecompany.com",
    "WHATSAPP_DISPLAY": "+1 786-613-5141",
    "DISCOUNT": "0.03",
    "INVOICE_DUE_DAYS": "3",
    "QBO_ENV": "sandbox",
    "QBO_CLIENT_ID": "AByXATBXP9CVUaqOMIFtunqRMByt9ZXNW9QL6Wc9W6hieNoc2J",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  }
  // Secrets (wrangler secret put): QBO_CLIENT_SECRET, TOKEN_KEY, LINK_SECRET, SYNC_TOKEN, TURNSTILE_SECRET
}
